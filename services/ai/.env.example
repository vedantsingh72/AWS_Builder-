# Groq (LangChain ChatGroq). Get a key at https://console.groq.com
GROQ_API_KEY=
# Default extraction model. Tool-use capable; override to llama-3.1-8b-instant for speed/cost.
AI_MODEL=llama-3.3-70b-versatile
# Domain writes go here (client.ts → HTTP). Never touch domain tables directly.
API_BASE_URL=http://api:3001
# LangGraph checkpoint tables live in this DB (same Postgres as api).
DATABASE_URL=postgresql://postgres:dev@postgres:5432/ai_office
PORT=3002
